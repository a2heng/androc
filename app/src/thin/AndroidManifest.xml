<?xml version="1.0" encoding="utf-8"?>
<!-- Thin (UI-only) manifest overlay: keep only the UI host and app updates. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"
        tools:node="remove" />

    <queries>
        <package android:name="com.topjohnwu.magisk" tools:node="remove" />
        <package android:name="me.weishu.kernelsu" tools:node="remove" />
        <package android:name="me.bmax.apatch" tools:node="remove" />
    </queries>

    <application>
        <!-- No local runtime, WebView fallback, toolbox or boot/watchdog in thin. -->
        <activity android:name=".MainActivity" tools:node="remove" />
        <service android:name=".LocalServerService" tools:node="remove" />
        <service android:name=".RuntimeUpdateService" tools:node="remove" />
        <provider android:name=".LocalServerInfoProvider" tools:node="remove" />
        <receiver android:name=".BootReceiver" tools:node="remove" />
        <service android:name=".ThinRuntimeService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <receiver android:name=".WatchdogReceiver" tools:node="remove" />
    </application>
</manifest>
